{
  "name": "docforge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/src/index.js",
    "test": "vitest run",
    "test:stage1": "vitest run test/validation.test.ts test/html.test.ts",
    "test:stage2": "vitest run test/overlay.test.ts",
    "test:stage3": "vitest run test/batch.test.ts",
    "setup": "playwright install chromium && tsx scripts/create-certificate.ts",
    "test:ui": "vitest run test/ui.test.ts",
    "test:converter": "vitest run test/converter.test.ts"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.1.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "dotenv": "^18.0.10",
    "fastify": "^5.0.0",
    "fflate": "^0.8.2",
    "handlebars": "^4.7.8",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "playwright": "^1.56.0",
    "sharp": "^0.35.5",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.12"
  }
}
